[worldserver]

########################################
# Server API
########################################
#
# Listener, authentication and request/WebSocket limit changes require a
# worldserver restart. Sampling intervals support config reload.
#
# ServerApi.Enable
#     Description: Enable the local HTTP API listener.
#     Default: 1 - Enabled
#              0 - Disabled
#
ServerApi.Enable = 1

# ServerApi.BindAddress defaults to localhost. Set it to 0.0.0.0 or a LAN
# interface address to accept connections from other hosts. With provider
# "none", API endpoints allow anonymous access; secure the network yourself.
ServerApi.BindAddress = "127.0.0.1"

# Requires restart after a change.
ServerApi.Port = 7878

# Maximum HTTP request size accepted by the MVP listener.
ServerApi.MaxRequestBytes = 1048576
ServerApi.MaxRequestsPerSecond = 1000
# Number of HTTP, SSE, and WebSocket I/O worker threads (1-32).
ServerApi.IOThreads = 4
ServerApi.PositionUpdates.IntervalMs = 1000
ServerApi.CombatSnapshot.IntervalMs = 2000

ServerApi.WebSocket.Enable = 1
ServerApi.WebSocket.MaxFrameBytes = 16384
ServerApi.WebSocket.MaxSubscriptions = 20
ServerApi.WebSocket.MaxQueue = 256
ServerApi.WebSocket.MaxQueueBytes = 2097152
ServerApi.WebSocket.MaxClients = 10
ServerApi.WebSocket.MaxMessagesPerSecond = 10000
ServerApi.WebSocket.MaxPublishQueue = 10000

# Server-Sent Events
ServerApi.SSE.Enable = 1
ServerApi.SSE.MaxSubscriptions = 20
ServerApi.SSE.MaxQueue = 256
ServerApi.SSE.MaxQueueBytes = 2097152
ServerApi.SSE.MaxClients = 10
ServerApi.SSE.HeartbeatSeconds = 15

# Authentication provider selected at startup. The built-in "none" provider
# allows unauthenticated access from any host that can reach the listener.
ServerApi.Auth.Provider = "none"
